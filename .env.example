# Copy this file to `.env` and fill in real values before running services.

# Database
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Kafka
# If multiple brokers, separate with commas: broker1:port,broker2:port
KAFKA_BROKERS="kafka-xxxxxxx-deploo.d.aivencloud.com:23192"
KAFKA_SASL_USERNAME="avnadmin"
KAFKA_SASL_PASSWORD="your_kafka_password_here"

# ClickHouse
CLICKHOUSE_URL="https://clickhouse-xxxxxx-deploo.f.aivencloud.com:23180"
CLICKHOUSE_USERNAME="avnadmin"
CLICKHOUSE_PASSWORD="your_clickhouse_password_here"

# AWS credentials (used for ECS/S3)
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="your_aws_secret_here"