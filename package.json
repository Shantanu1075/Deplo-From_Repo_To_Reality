{
  "name": "project-deplo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo workspace for the project services",
  "workspaces": [
    "api-server",
    "Build-Server",
    "frontend",
    "s3-reverse-proxy",
    "packages/prisma"
  ],
  "dependencies": {
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4"
  },
  "scripts": {
    "install:all": "npm install",
    "prisma:generate": "npm --workspace @project-deplo/prisma run prisma:generate"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0"
  }
}
